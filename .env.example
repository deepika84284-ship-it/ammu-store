# Backend Server Config
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ammu_frame_store?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=ammu_frame_store_super_secret_jwt_key_2026

# Cloudinary Storage Configuration (Optional - fallback to local storage if blank)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Config (.env in client/)
VITE_API_URL=http://localhost:5000/api
